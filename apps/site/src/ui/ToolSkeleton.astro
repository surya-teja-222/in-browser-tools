---
// Placeholder shown while a tool's island loads. Roughly matches a toolbar plus a work area so
// the page doesn't jump when the tool appears.
---

<div class="flex animate-pulse flex-col gap-4" aria-busy="true" aria-label="Loading tool">
  <div class="h-10 w-full max-w-md rounded-control bg-rule/60"></div>
  <div class="h-[min(60dvh,36rem)] rounded-panel border border-rule bg-surface"></div>
</div>
