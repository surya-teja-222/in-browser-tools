---
interface Props {
  /** Current tool name, shown after the site name as a breadcrumb. */
  current?: string;
}
const { current } = Astro.props;
---

<header class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-5 sm:px-8">
  <a
    href="/"
    class="group flex items-center gap-2.5 rounded-control font-display text-[1.0625rem] font-semibold tracking-tight"
  >
    <span class="size-3.5 rounded-full bg-sun transition-transform duration-300 ease-out-quart group-hover:scale-125"></span>
    <span>
      tools<span class="text-ink-muted">.itssurya.com</span>
    </span>
  </a>
  {current && (
    <>
      <span class="text-ink-muted" aria-hidden="true">
        /
      </span>
      <span class="truncate font-display text-[1.0625rem] text-ink-muted">{current}</span>
    </>
  )}
</header>
